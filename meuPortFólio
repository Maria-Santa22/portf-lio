<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maria Santa Pereira Nunes — Técnica em Informática para Internet</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0F1B2D;
    --surface: #142238;
    --line: #24374F;
    --text: #EAEFF5;
    --text-dim: #8FA3BB;
    --teal: #4FD1C5;
    --amber: #F2B84B;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'IBM Plex Sans', sans-serif;
    line-height:1.6;
    overflow-x:hidden;
  }
  h1,h2,h3{
    font-family:'Sora', sans-serif;
    font-weight:700;
    letter-spacing:-0.01em;
  }
  a{color:inherit; text-decoration:none;}
  .wrap{
    max-width:760px;
    margin:0 auto;
    padding:0 28px;
  }
  section{padding:96px 0;}
  @media (max-width:640px){
    section{padding:64px 0;}
    .wrap{padding:0 22px;}
  }

  /* ---------- NAV ---------- */
  nav{
    position:sticky; top:0; z-index:20;
    background:rgba(15,27,45,0.85);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{
    display:flex; justify-content:space-between; align-items:center;
    height:64px; max-width:760px;
  }
  .nav-name{font-family:'Sora',sans-serif; font-weight:600; font-size:1rem;}
  .nav-links{display:flex; gap:24px; font-size:0.92rem; color:var(--text-dim);}
  .nav-links a:hover{color:var(--teal);}
  @media (max-width:560px){
    .nav-links{gap:14px; font-size:0.82rem;}
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    padding:120px 0 100px;
    overflow:hidden;
    border-bottom:1px solid var(--line);
  }
  .hero-net{
    position:absolute; inset:0; z-index:0; opacity:0.55;
  }
  .hero .wrap{position:relative; z-index:1;}
  .kicker{
    font-family:'IBM Plex Mono', monospace;
    color:var(--teal);
    font-size:0.85rem;
    margin-bottom:18px;
  }
  .hero h1{
    font-size:clamp(2.1rem, 5vw, 3.2rem);
    line-height:1.12;
    max-width:11ch;
  }
  .hero p.lead{
    margin-top:22px;
    max-width:46ch;
    color:var(--text-dim);
    font-size:1.05rem;
  }
  .hero-goal{
    margin-top:36px;
    display:inline-flex;
    align-items:baseline;
    gap:10px;
    border-left:2px solid var(--amber);
    padding-left:14px;
  }
  .hero-goal .g-label{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.78rem;
    color:var(--amber);
  }
  .hero-goal .g-text{color:var(--text); font-size:0.95rem;}

  /* ---------- ABOUT ---------- */
  .about-grid{
    display:grid;
    grid-template-columns: 1.3fr 1fr;
    gap:48px;
  }
  @media (max-width:640px){
    .about-grid{grid-template-columns:1fr; gap:36px;}
  }
  .about h2{font-size:1.6rem; margin-bottom:20px;}
  .about p{color:var(--text-dim); margin-bottom:14px;}
  .traits{list-style:none; display:flex; flex-direction:column; gap:12px; margin-top:8px;}
  .traits li{
    font-size:0.95rem;
    padding-left:16px;
    position:relative;
    color:var(--text);
  }
  .traits li::before{
    content:"";
    position:absolute; left:0; top:0.5em;
    width:6px; height:6px;
    background:var(--teal);
    border-radius:50%;
  }
  .edu-block{
    border:1px solid var(--line);
    background:var(--surface);
    border-radius:6px;
    padding:22px;
  }
  .edu-block .school{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.78rem;
    color:var(--text-dim);
    margin-bottom:6px;
  }
  .edu-block .course{font-weight:600; font-size:1rem; margin-bottom:4px;}
  .edu-block .status{color:var(--amber); font-size:0.85rem;}
  .edu-block .certs{
    margin-top:16px; padding-top:16px;
    border-top:1px solid var(--line);
    color:var(--text-dim); font-size:0.9rem;
  }

  /* ---------- SKILLS ---------- */
  .skills-row{
    display:flex; flex-wrap:wrap; gap:12px;
    margin-top:8px;
  }
  .skill-chip{
    border:1px solid var(--line);
    padding:8px 16px;
    border-radius:999px;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.85rem;
    color:var(--text);
    background:var(--surface);
  }

  /* ---------- EXPERIENCE ---------- */
  .exp-list{margin-top:8px;}
  .exp-item{
    display:grid;
    grid-template-columns: 170px 1fr;
    gap:24px;
    padding:24px 0;
    border-top:1px solid var(--line);
  }
  .exp-item:last-child{border-bottom:1px solid var(--line);}
  @media (max-width:600px){
    .exp-item{grid-template-columns:1fr; gap:6px;}
  }
  .exp-role{font-family:'Sora', sans-serif; font-weight:600; font-size:1.05rem;}
  .exp-org{
    display:block; margin-top:6px;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.75rem; color:var(--teal);
  }
  .exp-desc{color:var(--text-dim); font-size:0.94rem;}

  /* ---------- CERTIFICATES ---------- */
  .cert-list{margin-top:8px;}
  .cert-item{
    display:flex; justify-content:space-between; align-items:baseline;
    gap:16px;
    padding:14px 0;
    border-bottom:1px solid var(--line);
  }
  .cert-name{font-size:0.96rem; color:var(--text);}
  .cert-meta{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.76rem;
    color:var(--text-dim);
    white-space:nowrap;
    text-align:right;
  }
  @media (max-width:560px){
    .cert-item{flex-direction:column; gap:4px;}
    .cert-meta{text-align:left;}
  }

  /* ---------- PROJECTS ---------- */
  .proj-list{
    margin-top:8px;
  }
  .proj{
    display:grid;
    grid-template-columns: 170px 1fr;
    gap:24px;
    padding:28px 0;
    border-top:1px solid var(--line);
  }
  .proj:last-child{border-bottom:1px solid var(--line);}
  @media (max-width:600px){
    .proj{grid-template-columns:1fr; gap:8px;}
  }
  .proj-name{
    font-family:'Sora', sans-serif;
    font-weight:600;
    font-size:1.15rem;
  }
  .proj-tag{
    display:block;
    margin-top:8px;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.72rem;
    color:var(--teal);
  }
  .proj-desc{color:var(--text-dim); font-size:0.96rem;}

  /* ---------- CONTACT ---------- */
  .contact h2{font-size:1.6rem; margin-bottom:12px;}
  .contact p.lead{color:var(--text-dim); max-width:44ch; margin-bottom:32px;}
  .contact-list{
    display:flex; flex-direction:column; gap:0;
    border-top:1px solid var(--line);
  }
  .contact-item{
    display:flex; justify-content:space-between; align-items:center;
    padding:18px 0;
    border-bottom:1px solid var(--line);
    font-size:0.98rem;
  }
  .contact-item .c-label{
    color:var(--text-dim);
    font-family:'IBM Plex Mono', monospace;
    font-size:0.8rem;
  }
  .contact-item .c-value{font-weight:500;}
  .contact-item a:hover{color:var(--teal);}

  footer{
    padding:32px 0;
    text-align:center;
    color:var(--text-dim);
    font-size:0.82rem;
    border-top:1px solid var(--line);
  }
</style>
</head>
